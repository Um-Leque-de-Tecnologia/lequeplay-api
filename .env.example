# --- Geral ---
APP_ENV=dev
LOG_LEVEL=info
PORT=8080

# --- Postgres (com pgvector) ---
# Ex.: postgres://lequeplay:lequeplay@localhost:5432/lequeplay?sslmode=disable
DB_DSN=postgres://lequeplay:lequeplay@localhost:5432/lequeplay?sslmode=disable
DB_MIGRATE_ON_START=true

# --- Keycloak ---
# Modo: dev (headers X-Debug-*) | oidc (valida JWT contra o JWKS do realm)
KEYCLOAK_MODE=dev
KEYCLOAK_BASE_URL=https://auth.rodolfodebonis.com.br
KEYCLOAK_REALM=lequeplay
KEYCLOAK_CLIENT_ID=lequeplay-api
# Obrigatório no modo oidc (vem do Vault em produção):
KEYCLOAK_CLIENT_SECRET=

# --- Gemini (embeddings da busca semântica) ---
# Obtenha em https://aistudio.google.com/apikey (vem do Vault em produção):
GEMINI_API_KEY=

# --- TMDB (ingestão do catálogo, usado no seed) ---
# v4 Read Access Token em https://www.themoviedb.org/settings/api (vem do Vault):
TMDB_READ_TOKEN=

# --- Busca ---
# Liga o rerank via Gemini LLM sobre os candidatos fundidos (custo/latência extra).
RERANK_ENABLED=false

# --- Docs (Swagger UI + OpenAPI) ---
# /docs e /openapi.yaml. Com DOCS_PUBLIC_HOST vazio, ficam acessíveis em qualquer host.
DOCS_ENABLED=true
DOCS_PUBLIC_HOST=

# --- Telemetria (opcional) ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=lequeplay-api
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
